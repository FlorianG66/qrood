# Configuration de production de QROOD.
# Copier ce fichier sur le serveur :  sudo cp deploy/qrood.env /etc/qrood.env
# puis remplacer chaque valeur entre <...> (sans garder les < >).

NODE_ENV=production
QROOD_PUBLIC_ORIGIN=https://qrood.fr
QROOD_HOST=127.0.0.1
QROOD_PORT=3000
QROOD_TRUST_PROXY=true
# 0 = ne jamais s'arrêter par inactivité (recommandé en production).
QROOD_IDLE_TIMEOUT_MINUTES=0

# Stripe en mode live (clés sk_live_... et whsec_live_...).
# Créer d'abord dans Stripe les produits mensuels Pro 12,00 € et Ultra 29,00 €
# avec « taxes incluses » (inclusive), puis le webhook (voir INSTALL-VPS.md, étape 4).
# Attention : `unit_amount` est en centimes — 1200 = 12,00 €, 2900 = 29,00 €.
QROOD_STRIPE_SECRET_KEY=sk_live_...
QROOD_STRIPE_PRICE_PRO=price_live_<pro>
QROOD_STRIPE_PRICE_ULTRA=price_live_<ultra>
QROOD_STRIPE_WEBHOOK_SECRET=whsec_live_...

# E-mail : transport API (obligatoire en production), compatible Resend.
# Démarrage rapide : Resend, clé API, expéditeur onboarding@resend.dev puis,
# une fois le domaine vérifié chez Resend, no-reply@qrood.fr.
QROOD_MAIL_TRANSPORT=api
QROOD_MAIL_API_URL=https://api.resend.com/emails
QROOD_MAIL_API_KEY=re_...
QROOD_MAIL_FROM=no-reply@qrood.fr